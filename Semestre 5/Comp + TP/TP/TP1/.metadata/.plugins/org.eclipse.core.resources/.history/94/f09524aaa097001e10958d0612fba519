package Exo2;
import java.util.Scanner;

public class Exo2 {

    public static void main(String[] args) {
        
    	System.out.println("Veuillez saisir une chaîne d'additions (par exemple,23+45+12+2) :");
        String Expression = "23+45+12+2+1";
            
        int Somme = calculerSomme(Expression);
        System.out.println("La somme est : " + Somme);
    }

    private static int calculerSomme(String Expression) {
        String[] nombres = Expression.split("\\+");
        int somme = 0;
        for (String nombre : nombres) {
            somme += Integer.parseInt(nombre);
        }
        return somme;
    }
}